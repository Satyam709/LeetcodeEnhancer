{
  "name": "leetcode-enhancer",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "description": "Community-powered company interview data for leetcode.com, rendered natively. No premium, no telemetry.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:sync": "tsx tools/sync-data/index.ts",
    "build": "tsx scripts/build.ts",
    "build:firefox": "tsx scripts/build.ts --browser=firefox",
    "package": "tsx scripts/package.ts",
    "dev": "tsx scripts/build.ts --watch",
    "format": "prettier --write ."
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
